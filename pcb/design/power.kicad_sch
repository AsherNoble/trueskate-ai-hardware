(text "12V motor rail only. 12mm shared bus; 2mm per-axis feeds; 1oz copper. Thermal evaluation stopped." (at 15 15.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 08417bd8-8f68-5bd3-a9e5-fd5bf325ba58)) (text "NC switch across J6: closed permits EN commands, open tri-states every EN output." (at 15 18.5 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 5a7dda86-7efe-5f0d-8745-4f583064037a)) (text "R1 pulls /OE high on open loop. Local R21-R26 pull EN low independently of firmware." (at 15 22.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid fce586a3-34f3-5831-aecd-a1c59573292e)) (text "Reclosing switch restores commanded state; no restart latch. Kill does NOT isolate 12V." (at 15 25.5 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 6624d3f7-8c96-513b-a590-bf5534b4a6bb)) (text "U1/U2 SN74LV125AN PDIP14, 3.3V, Ioff. Unused inputs tied; unused outputs NC." (at 15 29.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 54ee464b-e31f-5757-a271-b593b6641107)) )
